#include <stdio.h>
#define SIZE 5

int queue[SIZE];
int front = -1, rear = -1;

void insert(int value)
{
    if (rear == SIZE - 1)
    {
        printf("Queue Overflow\n");
        return;
    }

    if (front == -1)
        front = 0;

    rear++;
    queue[rear] = value;
}

void delete()
{
    if (front == -1 || front > rear)
    {
        printf("Queue Underflow\n");
        return;
    }

    printf("Deleted: %d\n", queue[front]);
    front++;
}

void display()
{
    int i;

    if (front == -1 || front > rear)
    {
        printf("Queue is empty\n");
        return;
    }

    printf("Remaining elements: ");

    for (i = front; i <= rear; i++)
        printf("%d ", queue[i]);

    printf("\n");
}

int main()
{
    insert(10);
    insert(20);
    insert(30);

    delete();
    delete();

    insert(40);

    display();

    return 0;
}

#include <stdio.h>
#define SIZE 5

int queue[SIZE];
int front = -1, rear = -1;

void insert(int value)
{
    if ((rear + 1) % SIZE == front)
    {
        printf("Circular Queue Overflow\n");
        return;
    }

    if (front == -1)
    {
        front = 0;
        rear = 0;
    }
    else
    {
        rear = (rear + 1) % SIZE;
    }

    queue[rear] = value;
}

void delete()
{
    if (front == -1)
    {
        printf("Circular Queue Underflow\n");
        return;
    }

    printf("Deleted: %d\n", queue[front]);

    if (front == rear)
    {
        front = -1;
        rear = -1;
    }
    else
    {
        front = (front + 1) % SIZE;
    }
}

void display()
{
    int i;

    if (front == -1)
    {
        printf("Queue is empty\n");
        return;
    }

    printf("Circular Queue: ");

    i = front;

    while (1)
    {
        printf("%d ", queue[i]);

        if (i == rear)
            break;

        i = (i + 1) % SIZE;
    }

    printf("\n");
}

int main()
{
    insert(10);
    insert(20);
    insert(30);
    insert(40);

    delete();
    delete();

    insert(50);
    insert(60);

    display();

    return 0;
}

#include <stdio.h>
#define SIZE 5

int deque[SIZE];
int front = -1, rear = -1;

void insertFront(int value)
{
    if ((front == 0 && rear == SIZE - 1) ||
        (front == rear + 1))
    {
        printf("Deque Overflow\n");
        return;
    }

    if (front == -1)
    {
        front = rear = 0;
    }
    else if (front == 0)
    {
        front = SIZE - 1;
    }
    else
    {
        front--;
    }

    deque[front] = value;
}

void insertRear(int value)
{
    if ((front == 0 && rear == SIZE - 1) ||
        (front == rear + 1))
    {
        printf("Deque Overflow\n");
        return;
    }

    if (front == -1)
    {
        front = rear = 0;
    }
    else if (rear == SIZE - 1)
    {
        rear = 0;
    }
    else
    {
        rear++;
    }

    deque[rear] = value;
}

void deleteFront()
{
    if (front == -1)
    {
        printf("Deque Underflow\n");
        return;
    }

    printf("Deleted from Front: %d\n", deque[front]);

    if (front == rear)
    {
        front = rear = -1;
    }
    else if (front == SIZE - 1)
    {
        front = 0;
    }
    else
    {
        front++;
    }
}

void deleteRear()
{
    if (rear == -1)
    {
        printf("Deque Underflow\n");
        return;
    }

    printf("Deleted from Rear: %d\n", deque[rear]);

    if (front == rear)
    {
        front = rear = -1;
    }
    else if (rear == 0)
    {
        rear = SIZE - 1;
    }
    else
    {
        rear--;
    }
}

void display()
{
    int i;

    if (front == -1)
    {
        printf("Deque is empty\n");
        return;
    }

    printf("Remaining elements: ");

    i = front;

    while (1)
    {
        printf("%d ", deque[i]);

        if (i == rear)
            break;

        i = (i + 1) % SIZE;
    }

    printf("\n");
}

int main()
{
    insertFront(10);
    insertRear(20);
    insertFront(30);

    deleteFront();
    deleteRear();

    display();

    return 0;
}

#include <stdio.h>
#define SIZE 5

struct PriorityQueue
{
    int data;
    int priority;
};

struct PriorityQueue queue[SIZE];
int rear = -1;

void insert(int data, int priority)
{
    if (rear == SIZE - 1)
    {
        printf("Priority Queue Overflow\n");
        return;
    }

    rear++;

    queue[rear].data = data;
    queue[rear].priority = priority;
}

void deleteHighestPriority()
{
    int i, pos = 0;

    if (rear == -1)
    {
        printf("Priority Queue is empty\n");
        return;
    }

    for (i = 1; i <= rear; i++)
    {
        if (queue[i].priority > queue[pos].priority)
        {
            pos = i;
        }
    }

    printf("Deleted element: %d\n", queue[pos].data);
    printf("Priority: %d\n", queue[pos].priority);

    for (i = pos; i < rear; i++)
    {
        queue[i] = queue[i + 1];
    }

    rear--;
}

void display()
{
    int i;

    printf("Remaining elements:\n");

    for (i = 0; i <= rear; i++)
    {
        printf("Element = %d, Priority = %d\n",
               queue[i].data,
               queue[i].priority);
    }
}

int main()
{
    insert(10, 2);
    insert(20, 1);
    insert(30, 3);

    deleteHighestPriority();

    display();

    return 0;
}
